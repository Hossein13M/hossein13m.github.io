{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate && node scripts/inline-css.mjs",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt prepare && vue-tsc --noEmit"
  },
  "lint-staged": {
    "**/*.{js,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@12.14.0",
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@vueuse/core": "15.0.0",
    "@vueuse/nuxt": "15.0.0",
    "nuxt": "4.6.1",
    "tailwindcss": "4.3.3",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.13"
  }
}
