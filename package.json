{
  "name": "hossein-dev",
  "version": "1.0.0",
  "private": true,
  "description": "Personal portfolio of Hossein Mousavi, a Senior DevOps Engineer. Static Nuxt site at https://hossein.dev.",
  "homepage": "https://hossein.dev",
  "bugs": {
    "url": "https://github.com/Hossein13M/hossein13m.github.io/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hossein13M/hossein13m.github.io.git"
  },
  "author": {
    "name": "Hossein Mousavi",
    "email": "dev.hosseinmousavi@gmail.com",
    "url": "https://hossein.dev"
  },
  "license": "MIT",
  "keywords": [
    "portfolio",
    "hossein-mousavi",
    "devops",
    "nuxt",
    "vue"
  ],
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate && node scripts/inline-css.mjs && node scripts/add-csp.mjs",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt prepare && vue-tsc --noEmit"
  },
  "lint-staged": {
    "**/*.{js,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@12.14.0",
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "nuxt": "4.6.2",
    "tailwindcss": "4.3.3",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.13"
  }
}
